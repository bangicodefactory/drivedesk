# .env.staging-directonderweg.example
# -------------------------------------------------------------------
# Template for the staging-directonderweg GitHub Environment secrets.
# Copy actual values into repo Settings → Environments →
# staging-directonderweg → Secrets.  NEVER commit real values here.
# -------------------------------------------------------------------

# ── App identity ───────────────────────────────────────────────────
APP_NAME="RentCar Staging"
APP_CLIENT=directonderweg
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.directonderweg.example.com

# Generate with: php artisan key:generate --show
# Must be different from the production APP_KEY.
APP_KEY=base64:REPLACE_WITH_STAGING_KEY

# ── Database (staging DB — never point at production) ─────────────
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_STAGING_DB_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_STAGING_DB_NAME
DB_USERNAME=REPLACE_WITH_STAGING_DB_USER
DB_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD

# ── Cache / Session / Queue ────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Mail (point at Mailpit / Mailtrap — never real customers) ──────
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_MAILPIT_OR_MAILTRAP_HOST
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=staging@directonderweg.example.com
MAIL_FROM_NAME="RentCar Staging"

# ── Stripe (test-mode keys only) ───────────────────────────────────
STRIPE_KEY=pk_test_REPLACE_WITH_TEST_PUBLISHABLE_KEY
STRIPE_SECRET=sk_test_REPLACE_WITH_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_TEST_WEBHOOK_SECRET

# ── PayPal (sandbox only) ──────────────────────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=REPLACE_WITH_SANDBOX_CLIENT_ID
PAYPAL_SANDBOX_CLIENT_SECRET=REPLACE_WITH_SANDBOX_CLIENT_SECRET

# ── Google reCAPTCHA (use Google test keys — always pass) ─────────
NOCAPTCHA_SITEKEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
NOCAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ── Sentry ─────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=REPLACE_WITH_SENTRY_DSN
SENTRY_ENVIRONMENT=staging-directonderweg
SENTRY_TRACES_SAMPLE_RATE=1.0

# ── Telescope / Debugbar (safe to enable on staging) ───────────────
TELESCOPE_ENABLED=true
DEBUGBAR_ENABLED=false
