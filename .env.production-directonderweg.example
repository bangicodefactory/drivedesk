# .env.production-directonderweg.example
# -------------------------------------------------------------------
# Template for the production-directonderweg GitHub Environment secrets.
# Copy actual values into repo Settings → Environments →
# production-directonderweg → Secrets.  NEVER commit real values here.
# -------------------------------------------------------------------

# ── App identity ───────────────────────────────────────────────────
APP_NAME="Direct Onderweg"
APP_CLIENT=directonderweg
APP_ENV=production
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_PRODUCTION_DOMAIN

# Generate with: php artisan key:generate --show
# Must be unique to production — never reuse staging or local keys.
APP_KEY=base64:REPLACE_WITH_PRODUCTION_KEY

# ── Database ───────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_PRODUCTION_DB_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_PRODUCTION_DB_NAME
DB_USERNAME=REPLACE_WITH_PRODUCTION_DB_USER
DB_PASSWORD=REPLACE_WITH_PRODUCTION_DB_PASSWORD

# ── Cache / Session / Queue ────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Mail (production SMTP provider) ───────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=REPLACE_WITH_FROM_EMAIL
MAIL_FROM_NAME="Direct Onderweg"

# ── Google reCAPTCHA v2 (production keys from console.cloud.google.com) ──
NOCAPTCHA_SITEKEY=REPLACE_WITH_PRODUCTION_SITE_KEY
NOCAPTCHA_SECRET=REPLACE_WITH_PRODUCTION_SECRET_KEY

# ── Sentry ─────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=REPLACE_WITH_SENTRY_DSN
SENTRY_ENVIRONMENT=production-directonderweg
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── Telescope / Debugbar (disabled in production) ──────────────────
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
