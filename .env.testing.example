# Copy to .env.testing (cp .env.testing.example .env.testing) — NOT .env.
#
# `php artisan test` / phpunit run with APP_ENV=testing (set in phpunit.xml),
# and Laravel loads .env.testing INSTEAD OF .env whenever it exists for that
# environment — it does not merge the two. Without this file, tests fall back
# to plain .env and run directly against your real dev database. Laravel's
# RefreshDatabase trait runs `migrate:fresh` (which drops every table) on
# whatever DB_DATABASE it finds the moment a new migration hasn't been applied
# yet — so every test run after adding a migration wipes your real data,
# including anything you uploaded (car pictures, custom settings, etc.).
# This file points tests at a separate `rentcar_testing` database instead, so
# they can never touch your real one. Create it once:
#   mysql -u root -e "CREATE DATABASE rentcar_testing;"
#
# phpunit.xml also pins CACHE_DRIVER=array, SESSION_DRIVER=array,
# QUEUE_CONNECTION=sync, MAIL_MAILER=array — those win over whatever this file
# says for the same keys, so you don't need to duplicate them here.

# Client branding comes from the Setting model (seeded per client).
# Change this only if you know what you're doing.
APP_NAME=rentcar
VITE_APP_NAME="${APP_NAME}"
# testing, not local. This file is only ever loaded when APP_ENV=testing
# (phpunit.xml sets it), and its own value then wins in-process --
# APP_ENV=local here would make app()->environment('local') true during
# the suite, registering the local-only dev routes and booting Telescope.
APP_ENV=testing
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Active client for this deployment — do not change for local dev
APP_CLIENT=drivedesk

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentcar_testing
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — Mailpit (https://github.com/axllent/mailpit) listens on 127.0.0.1:1025 by default
# array, so a test can never post real mail. phpunit.xml forces this too;
# it is spelled out here so the file cannot be read as an invitation.
MAIL_MAILER=array
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@drivedesk.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Stripe — use test-mode keys locally (pk_test_... / sk_test_...)
STRIPE_KEY=
STRIPE_SECRET=

# PayPal — sandbox only locally
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Live keys belong in the GitHub Environment for production — never commit them
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=

# Google reCAPTCHA v2 — use Google's always-pass test keys for local dev:
#   sitekey : 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   secret  : 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
NOCAPTCHA_SITEKEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
NOCAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Dev tools — enable locally, set to false (or omit) in production
# Run `php artisan telescope:migrate` once after enabling for the first time.
# Off for the suite: phpunit.xml already forces both false, and leaving them
# on here just means every test boots two profilers it never reads.
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# Activity-log (logged_histories) retention in days; nightly model:prune deletes
# older rows (perf-audit F-19). Raise for longer accountability/audit trails.
LOGGED_HISTORY_RETENTION_DAYS=365

# Sentry error monitoring — leave blank to disable locally.
# Set the real DSN in each GitHub Environment (production-drivedesk,
# staging-drivedesk). Never commit a real DSN here.
SENTRY_LARAVEL_DSN=
# Baked in at build/deploy time — identifies which commit produced the error.
SENTRY_RELEASE=
# Identifies which deployment environment the error came from.
# Use: local | staging-drivedesk | production-drivedesk
SENTRY_ENVIRONMENT=local
